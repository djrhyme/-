# 复制为 .env 后填写真实值。.env 不会被提交到仓库。

# ---- 数据库 ----
# 本地开发可用 docker：
# docker run -d --name vocab-site-pg -e POSTGRES_PASSWORD=change-me -e POSTGRES_DB=vocab_site -p 5439:5432 postgres:17-alpine
DATABASE_URL="postgresql://postgres:change-me@localhost:5439/vocab_site?schema=public"
# 使用 docker compose 部署时：数据库主机名是服务名 db，端口 5432，并与下面保持一致
# DATABASE_URL="postgresql://postgres:change-me@db:5432/vocab_site?schema=public"
POSTGRES_PASSWORD="change-me"

# ---- 站点 ----
# 生产环境填写备案后的域名，例如 https://your-domain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 邀请制访问：设置后注册页会出现「邀请码」必填项，注册与发送注册验证码都会校验它。
# 留空则任何人都可以注册。只给自己和受邀者使用时，请设置一个足够随机的值。
SITE_INVITE_CODE=""
# 对外公开的客服邮箱，写在隐私政策/免责声明页脚；留空则显示「请从注册邮箱联系管理员」
NEXT_PUBLIC_CONTACT_EMAIL=""

# ---- 邮件验证码（SendCloud）----
# console：开发模式，验证码只打印在服务端日志，并在注册接口响应里回传，方便本地联调。
# sendcloud：正式发送。生产构建（NODE_ENV=production）下 console 模式会被拒绝。
MAIL_PROVIDER="sendcloud"
SENDCLOUD_USER=""
SENDCLOUD_API_KEY=""
SENDCLOUD_FROM_EMAIL=""
SENDCLOUD_FROM_NAME="记词本"

# ---- 支付宝电脑网站支付（个体户商户）----
# 四项参数缺一不可；未配置时结算接口返回 payment_not_configured，订单保持待支付。
ALIPAY_APP_ID=""
# 应用私钥（PKCS#8 PEM 全文，或不带头的 base64 正文）
ALIPAY_PRIVATE_KEY=""
# 支付宝公钥（用于异步回调验签）
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# 必须是公网可访问、且已完成 ICP 备案的 https 地址
ALIPAY_NOTIFY_URL=""
ALIPAY_RETURN_URL=""
